# Google Gemini API Key (Required for embedding generation in ingest.py and main.py)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for LLM inference generation in workflow.py)
GROQ_API_KEY=your_groq_api_key_here

# Gemini Requests Per Minute throttling limit
GEMINI_RPM_LIMIT=5

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finintel

# Redis Stack connection string
REDIS_URL=redis://localhost:6379/0

# LangSmith Observability Configuration (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=FinIntel-Platform
